<p style="color: green"><%= notice %></p>

<% content_for :title, "Autores" %>

<h1>Autores</h1>

<%= form_with url: authors_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-3" do |form| %>
  <div class="grow min-w-56">
    <%= form.label :q, "Nome", class: "field-label" %>
    <%= form.search_field :q, value: params[:q], placeholder: "Buscar por nome", class: "field-input" %>
  </div>

  <%= form.submit "Filtrar", class: "btn btn-primary" %>
  <%= link_to "Limpar", authors_path, class: "btn btn-secondary" %>
<% end %>

<div id="authors" class="space-y-4">
  <% if @authors.empty? %>
    <p class="rounded-lg border border-dashed border-gray-300 p-6 text-center text-sm text-gray-500">
      Nenhum autor encontrado com esse filtro.
    </p>
  <% end %>

  <% @authors.each do |author| %>
    <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
      <%= render author %>
      <div class="mt-3">
        <%= link_to "Ver este autor", author, class: "btn btn-secondary" %>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-auto pt-8">
  <%= link_to "Novo autor", new_author_path, class: "btn btn-primary" %>
</div>
