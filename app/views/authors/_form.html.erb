<%= form_with(model: author, class: "space-y-4") do |form| %>
  <% if author.errors.any? %>
    <div class="rounded-lg border border-red-300 bg-red-50 p-4 text-red-700">
      <h2 class="font-medium"><%= pluralize(author.errors.count, "erro") %> impediram o cadastro:</h2>

      <ul class="list-disc list-inside mt-2 text-sm">
        <% author.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Nome", class: "field-label" %>
    <%= form.text_field :name, class: "field-input" %>
  </div>

  <div>
    <%= form.label :birth_year, "Ano de nascimento", class: "field-label" %>
    <%= form.number_field :birth_year, class: "field-input" %>
  </div>

  <div>
    <%= form.label :bio, "Bio", class: "field-label" %>
    <%= form.text_area :bio, rows: 4, class: "field-input" %>
  </div>

  <div>
    <%= form.submit "Salvar", class: "btn btn-primary" %>
  </div>
<% end %>
