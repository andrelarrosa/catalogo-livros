<div class="mx-auto md:w-2/3 w-full">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block" id="alert"><%= alert %></p>
  <% end %>

  <% content_for :title, "Atualizar senha" %>

  <h1 class="font-bold text-4xl">Atualizar senha</h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.label :password, "Nova senha", class: "field-label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password",
            placeholder: "Mínimo de 8 caracteres", maxlength: 72, class: "field-input" %>
    </div>

    <div class="my-5">
      <%= form.label :password_confirmation, "Confirmação da nova senha", class: "field-label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
            placeholder: "Repita a nova senha", maxlength: 72, class: "field-input" %>
    </div>

    <div class="sm:flex sm:items-center sm:gap-4">
      <%= form.submit "Salvar", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
