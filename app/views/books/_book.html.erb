<div id="<%= dom_id book %>">
  <div>
    <strong>Title:</strong>
    <%= book.title %>
  </div>

  <div>
    <strong>Author:</strong>
    <%= link_to book.author.name, book.author %>
  </div>

  <div>
    <strong>Year:</strong>
    <%= book.year %>
  </div>

  <div>
    <strong>Read:</strong>
    <%= book.read %>
  </div>

</div>
