<div id="<%= dom_id book %>">
  <div>
    <strong>Título:</strong>
    <%= book.title %>
  </div>

  <div>
    <strong>Autor:</strong>
    <%= link_to book.author.name, book.author %>
  </div>

  <div>
    <strong>Ano:</strong>
    <%= book.year %>
  </div>

  <div>
    <strong>Lido:</strong>
    <%= book.read? ? "Sim" : "Não" %>
  </div>

</div>
