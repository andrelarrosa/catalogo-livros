<p style="color: green"><%= notice %></p>

<% content_for :title, "Livros" %>

<h1>Livros</h1>

<%= form_with url: books_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-3" do |form| %>
  <div class="grow min-w-56">
    <%= form.label :q, "Título", class: "field-label" %>
    <%= form.search_field :q, value: params[:q], placeholder: "Buscar por título", class: "field-input" %>
  </div>

  <div class="w-48">
    <%= form.label :author_id, "Autor", class: "field-label" %>
    <%= form.select :author_id,
          options_from_collection_for_select(@authors, :id, :name, params[:author_id]),
          { include_blank: "Todos" }, class: "field-input" %>
  </div>

  <div class="w-40">
    <%= form.label :read, "Situação", class: "field-label" %>
    <%= form.select :read,
          options_for_select([ [ "Todos", "" ], [ "Lido", "read" ], [ "Não lido", "unread" ] ], params[:read]),
          {}, class: "field-input" %>
  </div>

  <%= form.submit "Filtrar", class: "btn btn-primary" %>
  <%= link_to "Limpar", books_path, class: "btn btn-secondary" %>
<% end %>

<div id="books" class="space-y-4">
  <% if @books.empty? %>
    <p class="rounded-lg border border-dashed border-gray-300 p-6 text-center text-sm text-gray-500">
      Nenhum livro encontrado com esses filtros.
    </p>
  <% end %>

  <% @books.each do |book| %>
    <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
      <%= render book %>
      <div class="mt-3">
        <%= link_to "Ver este livro", book, class: "btn btn-secondary" %>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-auto pt-8">
  <%= link_to "Novo livro", new_book_path, class: "btn btn-primary" %>
</div>
