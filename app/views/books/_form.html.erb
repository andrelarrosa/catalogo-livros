<%= form_with(model: book, class: "space-y-4") do |form| %>
  <% if book.errors.any? %>
    <div class="rounded-lg border border-red-300 bg-red-50 p-4 text-red-700">
      <h2 class="font-medium"><%= pluralize(book.errors.count, "erro") %> impediram o cadastro:</h2>

      <ul class="list-disc list-inside mt-2 text-sm">
        <% book.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Título", class: "field-label" %>
    <%= form.text_field :title, class: "field-input" %>
  </div>

  <div>
    <%= form.label :author_id, "Autor", class: "field-label" %>
    <%= form.collection_select :author_id, @authors, :id, :name, { prompt: "Selecione um autor" }, class: "field-input" %>
  </div>

  <div>
    <%= form.label :year, "Ano", class: "field-label" %>
    <%= form.number_field :year, class: "field-input" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.checkbox :read, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
    <%= form.label :read, "Lido", class: "text-sm font-medium text-gray-700" %>
  </div>

  <div>
    <%= form.submit "Salvar", class: "btn btn-primary" %>
  </div>
<% end %>
